[Unit]
Description=AVL GUI backend (FastAPI + AVL solver)
After=network.target

[Service]
User=avl
Group=avl
WorkingDirectory=/opt/avl-gui/backend
Environment=AVL_BIN=/usr/local/bin/avl
Environment=AVL_EXAMPLES_DIR=/opt/avl-gui/examples
ExecStart=/opt/avl-gui/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

# Hardening: the service can only write to the examples folder (AVL temp files).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/avl-gui/examples

[Install]
WantedBy=multi-user.target
